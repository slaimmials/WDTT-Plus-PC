# Shared contract between the app deploy (client/internal/deploy/deploy.sh) and
# the standalone installer. Changing any value requires updating both; the
# compatibility test enforces it. Marker strings are stored on servers and must
# not change.
WDTT_DEPLOY_CONTRACT_VERSION="1"
WDTT_SERVER_VERSION="20"
WDTT_SERVER_BINARY_PATH="/usr/local/bin/wdtt-server"
WDTT_SYSTEMD_UNIT_PATH="/etc/systemd/system/wdtt.service"
WDTT_CONFIG_DIRECTORY="/etc/wdtt"
WDTT_ACCESS_DATABASE="passwords.json"
WDTT_WG_KEYS_FILE="wg-keys.dat"
WDTT_APP_DEPLOY_MARKER="Managed by WDTT Plus Android deploy"
WDTT_APP_CONTRACT_MARKER="WDTT deploy compatibility: 1"
WDTT_APP_PRESERVED_MARKER="Preserved by WDTT Plus Android deploy"
